{
    "name": "marekskopal/typo3-recipe",
    "version": "1.0.0",
    "type": "typo3-cms-extension",
    "description": "Food recipes extension of plugin tx_news for TYPO3 CMS",
    "keywords": [
      "TYPO3",
      "recipes"
    ],
    "homepage": "https://marekskopal.cz",
    "authors": [
      {
        "name": "Marek Skopal",
        "role": "Developer",
        "homepage": "https://marekskopal.cz"
      }
    ],
    "license": ["GPL-2.0-or-later"],
    "require": {
      "typo3/cms-core": "^13.4.24",
      "typo3/cms-extbase": "^13.4.24",
      "georgringer/news": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "MarekSkopal\\MsRecipe\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ms_recipe"
        }
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "shipmonk/phpstan-rules": "^4.0",
        "slevomat/coding-standard": "^8.14"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
