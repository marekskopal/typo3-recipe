config.tx_extbase.persistence.classes {
    GeorgRinger\News\Domain\Model\News {
        subclasses {
            3 = MarekSkopal\MsRecipe\Domain\Model\Recipe
        }
    }

    MarekSkopal\MsRecipe\Domain\Model\Recipe {
        mapping {
            recordType = 3
            tableName = tx_news_domain_model_news
        }
    }
}

plugin.tx_news {
    view {
        partialRootPaths.300 = EXT:ms_recipe/Resources/Private/Partials/
    }
}
